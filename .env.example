# Variables d'environnement — local (.env.local) ou Coolify (Environment Variables)
# Ne jamais committer de secrets.

# Requis pour l'assistant IA (POST /api/assistant).
# Sans clé : fallback déterministe (pas d'appel OpenAI).
OPENAI_API_KEY=

# Optionnel — défaut : gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# --- Coolify (runtime, pas besoin dans le Dockerfile) ---
# Port exposé par le conteneur : 3000
# HOSTNAME est déjà forcé à 0.0.0.0 dans l'image
# Saisir OPENAI_API_KEY (et éventuellement OPENAI_MODEL) dans l'UI Coolify
