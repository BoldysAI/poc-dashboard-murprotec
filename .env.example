# Copier vers .env.local en local, ou injecter dans Coolify.
# Ne pas committer de vraies valeurs (.env et .env.local sont ignorés).

# Connexion mono-utilisateur (cookie JWT). Les trois sont obligatoires.
# AUTH_SECRET : au moins 32 caractères.
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=

# Assistant IA, optionnel. Sans clé, le chat reste sur les réponses locales.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
